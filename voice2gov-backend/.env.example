# Example environment variables for Voice2Gov backend
# Copy this to .env and update values for local development

# App
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/voice2gov

# NLP service
# If you run the Python NLP microservice locally, set this to http://localhost:8000
NLP_SERVICE_URL=http://localhost:8000

# Optional API key for NLP service (if configured)
NLP_API_KEY=

# External AI provider configuration (leave empty to use local / Python fallback)
# Set `AI_API_KEY` and provider host/path to enable the external AI service.
AI_API_KEY=
EXTERNAL_AI_HOST=
EXTERNAL_AI_PATH=
AI_MODEL=

# JWT secret used for signing auth tokens (change in production)
JWT_SECRET=change-this-in-production
# ─────────────────────────────────────────────
#  Voice2Gov  —  Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/voice2gov
# For Atlas: MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/voice2gov

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Python NLP microservice (optional)
NLP_SERVICE_URL=http://localhost:8000

# Socket.io (no extra config needed — same port as HTTP)
# Optional: Socket.io path override
# SOCKET_PATH=/socket.io

# ── External AI provider ──────────────────────────────────────────────────────
# Provide the API key and the provider host/path. When configured, the external
# AI provider will be used for complaint analysis and chat; otherwise the
# system falls back to the Python NLP service or the local rule-based engine.
AI_API_KEY=your-api-key-here
EXTERNAL_AI_HOST=api.your-ai-provider.com
EXTERNAL_AI_PATH=/v1/messages
AI_MODEL=ai-model-v1
